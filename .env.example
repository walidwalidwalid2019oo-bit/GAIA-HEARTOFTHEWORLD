# Copy to .env for local backend development. Never commit the real .env file.
# These are placeholders, not working credentials. Replace them privately.
GAIA_API_KEY=put_your_provider_key_here
GAIA_BASE_URL=https://api.groq.com/openai/v1
GAIA_MODEL=put_a_model_id_here
# Generate a random value of at least 32 characters for local API access.
GAIA_API_TOKEN=put_a_long_random_api_token_here
# Keep false for account-based access. Set true only for private legacy development.
GAIA_ALLOW_SHARED_TOKEN=false
GAIA_TIMEOUT_SECONDS=60
GAIA_DB_PATH=data/gaia.sqlite3
# Optional durable hosted database; supports PostgreSQL via SQLAlchemy + psycopg.
# Keep this URL private. When set, it takes precedence over GAIA_DB_PATH.
# GAIA_DATABASE_URL=postgresql://user:password@host:5432/database
# Comma-separated exact website origins allowed to call this API from a browser.
# GAIA_CORS_ORIGINS=https://your-site.example
